# Copy to .env. Never commit real values.
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:4200
# Supabase direct or SESSION pooler PostgreSQL URL, URL-encode password characters.
DATABASE_URL=postgresql://postgres:password@localhost:5432/codesentinel
DATABASE_SSL=false
# Optional PEM certificate path when your provider uses a private CA.
DATABASE_CA_FILE=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# Confirmed Supabase Auth users with these emails may sign in as faculty.
FACULTY_EMAILS=faculty@university.edu
REDIS_URL=redis://localhost:6379
JWT_SECRET=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# PEM text with literal \n between lines; use double quotes in .env.
GITHUB_PRIVATE_KEY=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback
GITHUB_WEBHOOK_SECRET=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Windows: .venv/Scripts/python.exe ; Linux: .venv/bin/python
PYTHON_EXECUTABLE=.venv/Scripts/python.exe
# Optional private model cache directory; defaults to backend/ml/models.
MODEL_DIRECTORY=
RUN_WORKER=true
VELOCITY_Z_THRESHOLD=3
# Enable only behind the single trusted Render reverse proxy.
TRUST_PROXY=false
